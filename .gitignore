.env
.env.*
!.env.example
node_modules/
dist/
build/
.gradle/
*.log
playwright-report/
test-results/
.DS_Store

# IDE-generated Java classes/resources
backend/bin/

# Terraform: actual inputs, state, plans and plugin cache contain sensitive account metadata
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
**/terraform.tfvars
**/*.auto.tfvars
**/*.auto.tfvars.json
**/interview.auto.tfvars.json.tmp
**/backend.hcl
**/backend_override.tf
crash.log
# .terraform.lock.hcl is intentionally tracked after terraform init -backend=false.
**/terraform.tfvars.json
infra/before.json

# CLI deployment metadata may include environment configuration
.aws-deploy/

# Python AIOps: dependency caches/generated Linux Lambda package
__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
*.pyc
lambda/aiops/build/

# Local credentials, editor settings and private keys (public CA .pem stays tracked)
.aws/
.ssh/
.codex/
.agents/
.idea/
.vscode/
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Additional Terraform inputs, saved plans, local bootstrap backend and debug logs
*.tfvars
*.tfvars.json
*.tfplan.*
*.plan
tfplan
plan.out
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
infra/bootstrap/backend.tf

# Terraform exported plans/state/output can contain plaintext sensitive values.
# Export plans as base.tfplan.json or one of the names below, never as source files.
**/tfplan.json
**/plan.json
**/terraform-plan*.json
**/terraform-plan*.txt
**/terraform-state*.json
**/terraform-output*.json
**/*.plan.json
**/*.plan.txt
**/*.tflock
# Environment-specific real backend inputs; *.hcl.example remains shareable.
**/backend.*.hcl
**/backend-config*.hcl
