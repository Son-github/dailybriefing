# Docker Compose local database
POSTGRES_DB=dashboard
POSTGRES_USER=sonny
POSTGRES_PASSWORD=password

# Local authentication (use at least 32 bytes)
JWT_SECRET=local-dev-only-secret-change-me-at-least-32-bytes
JWT_ACCESS_VALIDITY_MS=3600000

# External data providers
# Containers start without these values, but the corresponding cards need them.
EXCHANGE_API_KEY=
WEATHER_API_KEY=

# Optional market index providers
KIS_APP_KEY=
KIS_APP_SECRET=
TWELVE_DATA_API_KEY=
US_MARKET_SYMBOL=IXIC
