DB_HOST=localhost
DB_PORT=5432
DB_NAME=dailybriefing
DB_USERNAME=dailybriefing
DB_PASSWORD=replace-me-local-only-db-password
# 공유/운영 환경에서 반드시 교체: 최소 32 UTF-8 bytes
JWT_SECRET=replace-this-local-jwt-secret-with-32-or-more-bytes
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
COOKIE_SECURE=false
SPRING_PROFILES_ACTIVE=local
# DEMO는 샘플. LIVE는 아래 API 키/승인 필요, 실패를 샘플로 대체하지 않음.
DATA_MODE=DEMO
# 장소 검색/주소 변환/대중교통: Kakao REST API 키. JavaScript 지도키와 다릅니다.
# Kakao Developers → 앱 → 카카오맵 → 사용 설정 ON. 무료 쿼터/유료 이용 조건은 API_SETUP.md 참고.
KAKAO_REST_API_KEY=
KAKAO_PLACE_API_URL=https://dapi.kakao.com
KAKAO_ROUTE_API_URL=https://dapi.kakao.com/v2/routing/publictraffic
# 공개 JavaScript 지도키. REST key/secret을 VITE 변수에 넣지 마세요.
# SDK domain http://localhost:5173 등록 후 frontend rebuild 필요.
# 지도 화면: Kakao JavaScript 키. SDK 도메인 http://localhost:5173 등록 후 frontend 재빌드.
VITE_KAKAO_MAP_KEY=
# 날씨: 기상청 단기예보 활용신청 후 Decoding 인증키를 입력하세요.
# 반드시 공공데이터포털 일반 인증키(Decoding) 원본 입력. Encoding 키(%2B/%3D 등)는 넣지 마세요.
# 키는 코드에서 정확히 한 번 인코딩합니다. 기상청 API허브 authKey는 현재 지원하지 않습니다.
KMA_API_KEY=
KMA_API_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
# 공휴일: 한국천문연구원 특일정보 활용신청 후 Decoding 인증키를 입력하세요.
KASI_API_KEY=
KASI_API_URL=https://apis.data.go.kr/B090041/openapi/service/SpcdeInfoService
# 환율: 한국수출입은행에서 발급받은 환율 API key를 입력하세요.
KOREA_EXIM_API_KEY=
KOREA_EXIM_API_URL=https://oapi.koreaexim.go.kr/site/program/financial/exchangeJSON
# 뉴스: 네이버 클라우드 NAVER API HUB 앱의 Client ID. 신청 조건은 docs/API_SETUP.md 참고.
NAVER_API_CLIENT_ID=
# 뉴스: 같은 앱의 Client Secret. VITE_ 변수에 넣지 마세요.
NAVER_API_CLIENT_SECRET=
NAVER_API_URL=https://naverapihub.apigw.ntruss.com
API_CONNECT_TIMEOUT_MS=2000
API_READ_TIMEOUT_MS=4000
VITE_API_BASE=/api/v1
# 여러 backend replica에서는 한 인스턴스만 cleanup을 켜세요.
CALENDAR_CLEANUP_ENABLED=true
CALENDAR_CLEANUP_CRON="0 0 3 * * *"

# AWS prod 전용 선택 설정 (LOCAL에는 입력하지 않아도 됨):
# FRONTEND_URLS=https://실제-CF-domain,https://실제-frontend-domain
# DB_SSL_MODE=verify-full
# DB_SSL_ROOT_CERT=/app/certs/rds-global-bundle.pem
# 공개 runtime-config에는 REST 키/JWT/DB 비밀번호를 넣지 마세요. docs/LOCAL_VS_AWS.md 참고.
