# 이전 경로 호환용 로컬 Docker 설정이다.
# 새 설정은 저장소 루트의 .env.example을 .env로 복사해서 사용하는 것을 권장한다.
POSTGRES_DB=dashboard
POSTGRES_USER=sonny
POSTGRES_PASSWORD=change-me

JWT_SECRET=change-me-at-least-32-bytes-long
JWT_ACCESS_VALIDITY_MS=3600000
JWT_REFRESH_VALIDITY_MS=604800000

EXCHANGE_API_KEY=
WEATHER_API_KEY=

# 선택한 지수 제공자가 있을 때만 입력한다.
KIS_APP_KEY=
KIS_APP_SECRET=
TWELVE_DATA_API_KEY=
US_MARKET_SYMBOL=IXIC
